+:root{--artifact-version:__BUILD__;color-scheme:dark;--bg:#111827;--surface:#1e293b;--text:#f1f5f9;--muted:#cbd5e1;--border:#64748b;--button:#38bdf8;--on-button:#082f49}
+:root[data-theme=light]{color-scheme:light;--bg:#f1f5f9;--surface:#fff;--text:#0f172a;--muted:#334155;--border:#64748b;--button:#075985;--on-button:#fff}
+*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font:16px/1.5 system-ui}main{max-width:880px;margin:24px auto;padding:20px;background:var(--surface);border:1px solid var(--border);border-radius:16px}header{display:flex;gap:16px;align-items:center}h1{font-size:24px;margin:0}h2{font-size:18px}p,footer{color:var(--muted)}label{display:block;margin:12px 0}input,select,button{font:inherit;border:1px solid var(--border);border-radius:6px;padding:10px;background:var(--surface);color:var(--text)}input{display:block;width:100%}button{cursor:pointer;background:var(--button);color:var(--on-button);font-weight:650}button:disabled{opacity:.55;cursor:default}button:focus-visible,input:focus-visible,select:focus-visible{outline:3px solid var(--button);outline-offset:3px}.actions{display:flex;gap:10px;flex-wrap:wrap}section{margin:22px 0;padding:16px 0;border-top:1px solid var(--border)}[hidden]{display:none!important}footer{font-size:13px} @media(max-width:600px){main{margin:0;border-radius:0;padding:16px}h1{font-size:20px}}
