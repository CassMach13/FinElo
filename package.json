{
  "name": "finelo",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "backup:test": "pwsh -NoProfile -File scripts/backup/tests/Test-FinEloAsymmetricBackup.ps1",
    "backup:test-recipient": "pwsh -NoProfile -File scripts/backup/tests/Test-FinEloAsymmetricBackup.ps1 -ProductionRecipientFile security/backup/finelo-backup-recipient.txt",
    "typecheck": "tsc --noEmit --pretty false",
    "typecheck:baseline": "node scripts/check-type-baseline.mjs",
    "verify:baseline": "npm run typecheck:baseline && npm test && npm run build"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@stripe/stripe-js": "^8.6.1",
    "@supabase/supabase-js": "^2.84.0",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "driver.js": "^1.4.0",
    "framer-motion": "^12.36.0",
    "nodemailer": "^7.0.13",
    "papaparse": "^5.5.3",
    "pluggy-sdk": "^0.83.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-pluggy-connect": "^2.12.0",
    "react-router-dom": "^7.9.6",
    "stripe": "^22.1.0",
    "uuid": "^13.0.0",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@google/generative-ai": "^0.24.1",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "dotenv": "^17.4.1",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "~5.8.2",
    "vite": "^7.2.4",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^2.1.8"
  }
}
